<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity Core sources outside the editor. netstandard2.1 + C# 9 match what Unity 6 accepts,
       so anything that builds here also builds in Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TiltBox.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Meta/**/*.cs" />
  </ItemGroup>
</Project>
