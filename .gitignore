# Unity regenerates these at the project root; DevTools/ projects are hand-written and tracked.
/*.csproj
/*.sln
.vs/
.idea/
*.apk
*.aab
DevTools/**/bin/
DevTools/**/obj/

# --- Never commit secrets or signed app builds ---
# Signing keys (Android keystores, certificates, private keys)
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
keystore.properties
# Environment files and service credentials (keep a .env.example with blank values instead)
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
*credentials*.json
*service-account*.json
# App builds and store uploads
*.apk
*.aab
*.ipa
*.exe
/[Bb]uild*/
/Release*/

# Generator output (reproducible with DevTools/LevelLab fill)
/LevelCandidates/
